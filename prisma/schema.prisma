generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String
  price       Float
  stock       Int      @default(0)
  featured    Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?

  orders Order[]

  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  total       Float
  status      String   @default("pending")
  payment     String
  shipping    String

  customerId  String
  customer    Customer @relation(fields:[customerId], references:[id])

  userId      String?
  user        User? @relation(fields:[userId], references:[id])

  createdAt DateTime @default(now())
}
